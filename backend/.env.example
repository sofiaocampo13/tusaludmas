# Variables de la base de datos: van en backend/.env
# Variables del correo (SMTP_*): van en backend/.env.local, que git ignora.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
PORT=3000

# Correo que envía los códigos de recuperación de contraseña.
# SMTP_PASS es una "contraseña de aplicación" de Gmail (Cuenta de Google >
# Seguridad > Contraseñas de aplicaciones), NO la contraseña normal de la cuenta.
# Se entrega por un canal privado, nunca por git.
SMTP_USER=tusaludmas8@gmail.com
SMTP_PASS=
